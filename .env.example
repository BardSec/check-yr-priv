# Microsoft Entra / Azure AD App Registration
# Create an app registration at https://portal.azure.com -> Azure Active Directory -> App registrations
AZURE_CLIENT_ID=your-client-id-here
AZURE_CLIENT_SECRET=your-client-secret-here
AZURE_TENANT_ID=your-tenant-id-here

# Redirect URI registered in your app registration
# For local dev: http://localhost/auth/callback
# For production: https://yourdomain.com/auth/callback
AZURE_REDIRECT_URI=http://localhost/auth/callback

# Strong random secret for session signing — generate with: openssl rand -hex 32
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32

# App base URL (used for redirects)
APP_BASE_URL=http://localhost

# Required API Permissions (Delegated) to grant in your app registration:
#   - User.Read
#   - Directory.Read.All
#   - RoleManagement.Read.All
#   - PrivilegedAccess.Read.AzureAD
#   - Policy.Read.All
#   - AuditLog.Read.All   (optional — for sign-in MFA evidence)
